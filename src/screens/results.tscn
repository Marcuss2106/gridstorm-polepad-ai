[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/results.gd" id="1_results"]

[node name="Results" type="Control" node_paths=PackedStringArray("annotated_image_rect", "pole_id_label", "pole_type_label", "components_label", "encroachment_label", "severity_label")]
